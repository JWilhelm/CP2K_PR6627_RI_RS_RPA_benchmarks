&GLOBAL
  PROJECT mgo_gthpbe_Q_k8_a4.06
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ccGTH
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-7
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     2.03000000     2.03000000
      B     2.03000000     0.00000000     2.03000000
      C     2.03000000     2.03000000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      Mg       0.00000000     0.00000000     0.00000000
      O        2.03000000     2.03000000     2.03000000
    &END COORD
    &KIND Mg
      BASIS_SET cc-pVQZ-GTH-HF-q10
      POTENTIAL GTH-PBE-q10
    &END KIND
    &KIND O
      BASIS_SET cc-pVQZ-GTH-HF-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
