&GLOBAL
  PROJECT bn_hf_Q_k8_ri4_rs18_a3.54
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ccGTH
    POTENTIAL_FILE_NAME POTENTIAL_GTH_HF
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-7
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        &RI_RS_RPA
          NUM_TIME_FREQ_POINTS 20
          &AUTO_RI
            RI_AO_RATIO 4
          &END AUTO_RI
          &RI_RS
            TIKHONOV 1e-4
            &GRID_OPTIMIZATION
              RS_AO_RATIO 18
              MAX_ITER 200
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     1.77000000     1.77000000
      B     1.77000000     0.00000000     1.77000000
      C     1.77000000     1.77000000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      B        0.00000000     0.00000000     0.00000000
      N        0.88500000     0.88500000     0.88500000
    &END COORD
    &KIND B
      BASIS_SET cc-pVQZ-GTH-HF-q3
      POTENTIAL GTH-HF-q3
    &END KIND
    &KIND N
      BASIS_SET cc-pVQZ-GTH-HF-q5
      POTENTIAL GTH-HF-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
