&GLOBAL
  PROJECT Si_aTZ_RIbig
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_ae
    BASIS_SET_FILE_NAME BASIS_RI_AUG_MOLOPT_ae
    BASIS_SET_FILE_NAME /scratch/hpc-prf-dyncrys/eprop2d1_Jan/02_Claude/0073_allelectron_bandstructures/cases/BASIS_RI_Si_big
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-dyncrys/eprop2d1_Jan/02_Claude/0073_allelectron_bandstructures/runs/Si_aTZ_RI3e-4_ana/Si_aTZ_RI3e-4-RESTART.kp
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 12
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 100
    &END MGRID
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      SCF_GUESS RESTART
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        &RI_RS
          GRID_SELECT 1
        &END RI_RS
      &END GW
      &BANDSTRUCTURE_PATH
        NPOINTS 32
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT X 0 0.5 0.5
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT K 0.375 0.375 0.75
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT U 0.25 0.625 0.625
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT K 0.375 0.375 0.75
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 0.00000000 2.71550000 2.71550000
      B 2.71550000 0.00000000 2.71550000
      C 2.71550000 2.71550000 0.00000000
    &END CELL
    &COORD
      SCALED T
      Si 0 0 0
      Si .25 .25 .25
    &END COORD
    &KIND Si
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_Si_big
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
