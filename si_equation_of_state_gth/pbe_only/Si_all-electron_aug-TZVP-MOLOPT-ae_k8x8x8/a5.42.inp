&GLOBAL
  PROJECT si2_ae_augTZVPae_gapw_pbe_a5.42
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_ae
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    AUTO_BASIS RI_AUX MEDIUM
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
      METHOD GAPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-7
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &PRINT
      &OVERLAP_CONDITION ON
        DIAGONALIZATION T
      &END OVERLAP_CONDITION
    &END PRINT
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     2.71000000     2.71000000
      B     2.71000000     0.00000000     2.71000000
      C     2.71000000     2.71000000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      Si     0.00000000     0.00000000     0.00000000
      Si     1.35500000     1.35500000     1.35500000
    &END COORD
    &KIND Si
      BASIS_SET aug-TZVP-MOLOPT-ae
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
