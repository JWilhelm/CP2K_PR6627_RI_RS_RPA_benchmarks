&GLOBAL
  PROJECT si2_medium_cc-pVTZ_a5.46
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ccGTH_Si
    POTENTIAL_FILE_NAME POTENTIAL_Si_GTH_PBE_HF
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 6
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        &RI_RS_RPA
          NUM_TIME_FREQ_POINTS 20
          &AUTO_RI
            RI_AO_RATIO 2.5
          &END AUTO_RI
          &RI_RS
            &GRID_OPTIMIZATION
              RS_AO_RATIO 8
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     2.73000000     2.73000000
      B     2.73000000     0.00000000     2.73000000
      C     2.73000000     2.73000000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      Si     0.00000000     0.00000000     0.00000000
      Si     1.36500000     1.36500000     1.36500000
    &END COORD
    &KIND Si
      BASIS_SET cc-pVTZ-GTH-HF-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
