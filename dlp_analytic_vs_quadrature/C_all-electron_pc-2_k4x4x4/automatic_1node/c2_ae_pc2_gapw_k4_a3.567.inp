&GLOBAL
  PROJECT c2_ae_pc2_gapw_k4_a3.567
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
      METHOD GAPW
    &END QS
    &SCF
      SCF_GUESS RESTART
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-7
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        &RI_RS_RPA
          NUM_TIME_FREQ_POINTS 20
          &AUTO_RI
            RI_AO_RATIO 2.5
          &END AUTO_RI
          &RI_RS
            &GRID_OPTIMIZATION
              RS_AO_RATIO 8
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     1.78350000     1.78350000
      B     1.78350000     0.00000000     1.78350000
      C     1.78350000     1.78350000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      C      0.00000000     0.00000000     0.00000000
      C      0.89175000     0.89175000     0.89175000
    &END COORD
    &KIND C
      BASIS_SET pc-2
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
