&GLOBAL
  PROJECT si2_tzsopt_k6_a5.50
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_ccpVXZs
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 6
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-16
      EPS_PGF_ORB 1.0E-20
      METHOD GAPW
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-7
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        &RI_RS_RPA
          NUM_TIME_FREQ_POINTS 20
          &RI_RS
            GRID_SELECT 3
            &GRID_OPTIMIZATION
              MAX_ITER 200
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A     0.00000000     2.75000000     2.75000000
      B     2.75000000     0.00000000     2.75000000
      C     2.75000000     2.75000000     0.00000000
      CANONICALIZE F
    &END CELL
    &COORD
      Si     0.00000000     0.00000000     0.00000000
      Si     1.37500000     1.37500000     1.37500000
    &END COORD
    &KIND Si
      BASIS_SET ORB cc-pVTZ-s
      BASIS_SET RI_AUX cc-pVTZ-s-FIT
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
